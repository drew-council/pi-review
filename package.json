{
  "name": "@bizmyth/pi-review",
  "version": "0.1.0",
  "description": "A read-only branch review command for the Pi coding agent",
  "type": "module",
  "license": "MIT",
  "author": "Drew Council",
  "packageManager": "bun@1.3.13",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "check": "biome ci . && tsgo -p tsconfig.json && bun test",
    "check:fix": "biome check --write --unsafe . && tsgo -p tsconfig.json && bun test",
    "test": "bun test",
    "prepublishOnly": "bun run check && npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/bun": "^1.4.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drew-council/pi-review.git"
  },
  "bugs": {
    "url": "https://github.com/drew-council/pi-review/issues"
  },
  "homepage": "https://github.com/drew-council/pi-review#readme"
}
